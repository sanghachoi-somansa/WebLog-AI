# ---------------------------------------------------------------------------
# SSH: 선택 사항(개발 편의). 실제 접속 정보는 앱 사이드바에서 입력·변경합니다.
# ---------------------------------------------------------------------------
SSH_HOST=
SSH_USER=
SSH_PASSWORD=
LOG_PATH=/var/log/auth.log

# ---------------------------------------------------------------------------
# LLM: Base URL은 core/config.py 고정. 모델 id는 팀 로컬 LLM 설정과 일치해야 함.
# 기본값 qwen3-vl (권장). 앱 사이드바에서도 모델 선택 가능; 여기 값은 첫 방문·세션 기본에 사용.
# ---------------------------------------------------------------------------
VLLM_API_KEY=dummy
VLLM_MODEL=qwen3-vl

# LLM 호출 끄기(SSH 로그만): 1
DISABLE_LLM=0

# LLM 500 등 발생 후 같은 호출 반복 방지(초)
LLM_COOLDOWN_AFTER_ERROR=120

# ---------------------------------------------------------------------------
# Docker 배포 (서버에서 cp .env.example .env 후 필요 시만 수정)
# ---------------------------------------------------------------------------
# Somansa NLAB Rocky 미러(권장 순서):
#   curl http://rocky.mirror.lab.somansa.com/enable.sh | sudo bash -
#   curl http://rocky.mirror.lab.somansa.com/cert.sh | sudo bash -
#   curl http://rocky.mirror.lab.somansa.com/docker.sh | sudo bash -
# Docker Compose 기본값이 사내 미러(docker.lab.somansa.com)임.
# `docker pull docker.lab.somansa.com/...` 가 x509 이면 호스트에:
#   /etc/docker/certs.d/docker.lab.somansa.com/ca.crt  (회사 루트 CA PEM)
# 후 `systemctl restart docker` — docker-compose.yml 상단 주석 참고.
# 미러 밖(예: 집 PC)에서 빌드할 때만 Hub 로 덮어쓰기:
# CADDY_IMAGE=caddy:2-alpine
# PYTHON_BASE=python:3.12-slim-bookworm
